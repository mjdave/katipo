#This file is loaded by Katipo any time we host, either from katipoHost or the Katipo Browser

loadSingleFile = function(fullPath, fileName, fileChecksum)
{
    fileData = file.loadData(fullPath)
    if(fileData)
    {
        fileDataWrapper = {
            fileName = fileName
            checksum = fileChecksum
            data = fileData
        }
        return fileDataWrapper
    }
    return nil
}

loadFilesRecursively = function(clientFiles, clientChecksums, fullPath, localPathOrNil)
{
    if(file.isDirectory(fullPath))
    {
        contents = file.directoryContents(fullPath)
        for(fileOrDirectory in contents)
        {
            if(string.subString(fileOrDirectory, 0, 1) != ".")
            {
                subLocalPath = fileOrDirectory
                if(localPathOrNil)
                {
                    subLocalPath = localPathOrNil + "/" + fileOrDirectory
                }
                loadFilesRecursively(clientFiles, clientChecksums, fullPath + "/" + fileOrDirectory, subLocalPath)
            }
        }
    }
    else if(localPathOrNil)
    {
        fileChecksum = file.sha1(fullPath)

        if(!clientChecksums or (clientChecksums[localPathOrNil] != fileChecksum))
        {
            fileDataWrapper = loadSingleFile(fullPath, localPathOrNil, fileChecksum)
            if(fileDataWrapper)
            {
                table.insert(clientFiles, fileDataWrapper)
            }
        }
    }
}

loadFiles = function(clientSitePath, clientChecksums)
{
    clientFiles = {}
    loadFilesRecursively(clientFiles, clientChecksums, clientSitePath)
    return clientFiles
}

getChecksum = function(path)
{
    checksums = {}
    checksumRecursively(checksums, path)
    return checksums
    /*if(cachedChecksum) #todo finish this (reset below in update loop), spamming / is a potential DOS attack vector for large sites otherwise
    {
        return cachedChecksum
    }
    .cachedChecksum = string.sha1(checksumRecursively(path))
    cachedChecksum = .cachedChecksum
    return cachedChecksum*/
}

sendPublicDataKeys = {}

getPublicData = function(key)
{
    sendPublicDataKeys[key] = true
    savedData = database.get("p_" + key)
    if(savedData)
    {
        return savedData
    }
    return nil
}

setPublicData = function(key, data)
{
    sendPublicDataKeys[key] = true
    database.set("p_" + key, data)
}

getPrivateData = function(key)
{
    return database.get(key)
}

setPrivateData = function(key, data)
{
    database.set(key, data)
}

### this function is called when clients query this site
get = function(url, clientChecksumsOrCallbackFunc)
{
    clientChecksums = clientChecksumsOrCallbackFunc
    if(type(clientChecksums) != "table")
    {
        clientChecksums = nil
    }
    siteInfo = require(katipo.sitePath + "/site.tui")
    clientSitePath = file.getAbsolutePath(katipo.sitePath + "/clientSite")
    if(!file.fileExists(clientSitePath))
    {
        error("missing public data directory:", clientSitePath)
    }


    #print("in get. url:", url, " clientChecksum:", clientChecksum)
    urlSplit = string.split(url, "/")

    if(table.count(urlSplit) <= 1) #respond to get at the root level: "nameKey/" or "nameKey"
    {
        #print("sendPublicDataKeys:", sendPublicDataKeys)
        publicData = false
        for(k,v in sendPublicDataKeys)
        {
            if(!publicData)
            {
                .publicData = {}
            }
            #print("loading data:", k)
            publicData[k] = database.get("p_" + k)
        }

        #these files could be cached, however this way, changes are immediate when the client reloads, without needing to restart the host process
        files = loadFiles(clientSitePath, clientChecksums)

        clientSiteData = {
            files = files
            publicData = publicData
            siteInfo = siteInfo
            #siteImage = siteImage
        }
        return {
            status = "ok"
            siteData = clientSiteData
        }
    }
    else
    {
        if(urlSplit[1] == "install")
        {
            if(siteInfo.shareHost)
            {
                siteFiles = loadFiles(katipo.sitePath, clientChecksums)

                hostSiteData = {
                    siteFiles = siteFiles
                    siteInfo = siteInfo
                }
                return {
                    status = "ok"
                    hostSiteData = hostSiteData
                }
            }
        }
    }

    return {
        status = "error"
        message = "unhandled request"
    }
}

siteCode = false

update = function(dt) #called by BrowserHost
{
    if(siteCode)
    {
        siteCode.update(dt)
    }
}

start = function(isCommandLine)
{
    if(!katipo.sitePath)
    {
        print("\nError: katipoHost requires a site directory path to be passed with --site. run './katipoHost --help' for more information")
        return
    }

    siteInfoPath = katipo.sitePath + "/site.tui"
    siteCodePath = katipo.sitePath + "/code.tui"

    if(!file.fileExists(siteInfoPath))
    {
        print("\nError: Unable to find site.tui file at:", file.getAbsolutePath(siteInfoPath))
        return
    }

    siteInfo = require(siteInfoPath)
    .siteCode = false

    if(file.fileExists(siteCodePath))
    {
        .siteCode = require(siteCodePath)
    }

    #print("siteInfo:", siteInfo)
    #print("siteCode:", siteCode)

    katipo.siteInfo = siteInfo
    katipo.onConnected = function()
    {
        print("Successfully connected to katipo tracker server, with host name:", siteInfo.nameKey)
    }

    ### initialize katipo now that we have loaded the launch args
    success = katipo.init()
    if(!success)
    {
        print("Failed to initialize katipo.")
        return
    }

    if(siteCode and siteCode.init)
    {
        siteCode.init()
    }

    katipo.get = function(url, clientData)
    {
        if(siteCode and siteCode.get)
        {
            return siteCode.get(url, clientData)
        }
        return get(url, clientData)
    }

    print("Attempting to connect to tracker...")

    
    if(isCommandLine)
    {
        if(siteCode and siteCode.runLoop)
        {
            siteCode.runLoop()
        }
        else if(siteCode and siteCode.update)
        {
            while(true)
            {
                sleep(0.1)
                siteCode.update(0.1)#todo this is not accurate
            }
        }
        else
        {
            while(true)
            {
                print("Type 'quit' to cancel and exit, 'help' for more commands.")

                value = readValue()

                if(value == "help")
                {
                    print("Katipo Host version:", katipo.version)
                    print("")
                    print("available commands:")
                    print("help: prints this text")
                    print("quit or exit: exits")
                }
                else if(value == "quit" or value == "exit")
                {
                    break
                }
                else
                {
                    print("unhandled command:", value)
                }
            }
        }
    }
}