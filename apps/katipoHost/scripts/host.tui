
loadFilesFromDir = function(dirPath)
{
    files = {}
    contents = file.directoryContents(dirPath)
    for(fileName in contents)
    {
        if(string.subString(fileName, 0, 1) != ".")
        {
            fullPath = dirPath + "/" + fileName
            if(file.isDirectory(fullPath))
            {
                subFiles = loadFilesFromDir(fullPath)
                if(subFiles)
                {
                    fileDataWrapper = {
                        fileName = fileName,
                        files = subFiles
                    }
                    table.insert(files, fileDataWrapper)
                }
            }
            else
            {
                fileData = file.loadData(fullPath)
                if(fileData)
                {
                    fileDataWrapper = {
                        fileName = fileName,
                        data = fileData
                    }
                    table.insert(files, fileDataWrapper)
                }
            }
        }
    }
    if(table.count(files) == 0)
    {
        return nil
    }
    return files
}

cachedChecksum = false

checksumRecursively = function(path)
{
    #print("checksumRecursively:", path)
    if(file.isDirectory(path))
    {
        contents = file.directoryContents(path)
        foundResult = false //token 47
        for(fileOrDirectory in contents)
        {
            #print("fileOrDirectory:", fileOrDirectory, " contents:", contents)
            thisResult = checksumRecursively(path + "/" + fileOrDirectory)
            #print("thisResult a:", thisResult)
            if(thisResult)
            {
                if(foundResult)
                {
                    #print("foundResult b:", foundResult)
                    foundResult += thisResult
                }
                else
                {
                    #print("foundResult c:", foundResult)
                    debug.break()
                    .foundResult = thisResult
                    #print("foundResult f:", foundResult)
                }
            }
            #print("foundResult d:", foundResult)
        }
        #print("foundResult e:", foundResult) //false, token 47, bool in locals but the value stored at this level in the parent is correct
        if(foundResult)
        {
            return foundResult
        }
    }
    else
    {
        fileName = file.fileName(path)
        if(fileName and string.subString(fileName, 0, 1) != ".")
        {
            #print("returning sha1 for file:", path)
            return file.sha1(path)
        }
    }

    #print("nil")
    return nil
}

getChecksum = function(path)
{
    combinedChecksum = checksumRecursively(path)
    #print("combinedChecksum:", combinedChecksum)
    return string.sha1(combinedChecksum)
    /*if(cachedChecksum) #todo finish this (reset below in update loop), spamming / is a potential DOS attack vector for large sites otherwise
    {
        return cachedChecksum
    }
    .cachedChecksum = string.sha1(checksumRecursively(path))
    cachedChecksum = .cachedChecksum
    return cachedChecksum*/
}

