
loadFilesRecursively = function(clientFiles, clientChecksums, fullPath, localPathOrNil)
{
    if(file.isDirectory(fullPath))
    {
        contents = file.directoryContents(fullPath)
        for(fileOrDirectory in contents)
        {
            if(string.subString(fileOrDirectory, 0, 1) != ".")
            {
                subLocalPath = fileOrDirectory
                if(localPathOrNil)
                {
                    subLocalPath = localPathOrNil + "/" + fileOrDirectory
                }
                loadFilesRecursively(clientFiles, clientChecksums, fullPath + "/" + fileOrDirectory, subLocalPath)
            }
        }
    }
    else if(localPathOrNil)
    {
        fileChecksum = file.sha1(fullPath)

        if(!clientChecksums or (clientChecksums[localPathOrNil] != fileChecksum))
        {
            fileData = file.loadData(fullPath)
            if(fileData)
            {
                fileDataWrapper = {
                    fileName = localPathOrNil
                    checksum = fileChecksum
                    data = fileData
                }
                table.insert(clientFiles, fileDataWrapper)
            }
        }
    }
}

loadFiles = function(clientSitePath, clientChecksums)
{
    clientFiles = {}
    loadFilesRecursively(clientFiles, clientChecksums, clientSitePath)
    return clientFiles
}

getChecksum = function(path)
{
    checksums = {}
    checksumRecursively(checksums, path)
    return checksums
    /*if(cachedChecksum) #todo finish this (reset below in update loop), spamming / is a potential DOS attack vector for large sites otherwise
    {
        return cachedChecksum
    }
    .cachedChecksum = string.sha1(checksumRecursively(path))
    cachedChecksum = .cachedChecksum
    return cachedChecksum*/
}

sendPublicDataKeys = {}

getPublicData = function(key)
{
    sendPublicDataKeys[key] = true
    savedData = database.get("p_" + key)
    if(savedData)
    {
        return savedData
    }
    return nil
}

setPublicData = function(key, data)
{
    sendPublicDataKeys[key] = true
    database.set("p_" + key, data)
}

getPrivateData = function(key)
{
    return database.get(key)
}

setPrivateData = function(key, data)
{
    database.set(key, data)
}

### this function is called when clients query this site
get = function(url, clientChecksumsOrCallbackFunc)
{
    clientChecksums = clientChecksumsOrCallbackFunc
    if(type(clientChecksums) != "table")
    {
        clientChecksums = nil
    }
    siteInfo = require(katipo.sitePath + "/site.tui")
    clientSitePath = file.getAbsolutePath(katipo.sitePath + "/clientSite")
    if(!file.fileExists(clientSitePath))
    {
        error("missing public data directory:", clientSitePath)
    }


    #print("in get. url:", url, " clientChecksum:", clientChecksum)
    urlSplit = string.split(url, "/")

    if(table.count(urlSplit) <= 1) #respond to get at the root level: "nameKey/" or "nameKey"
    {
        # This checksums all of the client code, and clients check against it, like a version number. 
        # So clients will automatically download any updates to the site as an entire blob, but load from a cache otherwise
        
        #print("sendPublicDataKeys:", sendPublicDataKeys)
        publicData = false
        for(k,v in sendPublicDataKeys)
        {
            if(!publicData)
            {
                .publicData = {}
            }
            #print("loading data:", k)
            publicData[k] = database.get("p_" + k)
        }

        #these files could be cached, however this way, changes are immediate when the client reloads, without needing to restart the host process
        files = loadFiles(clientSitePath, clientChecksums)

        clientSiteData = {
            files = files
            publicData = publicData
            siteInfo = siteInfo
            #siteImage = siteImage
        }
        return {
            status = "ok"
            siteData = clientSiteData
        }
    }

    return {
        status = "error"
        message = "unhandled request"
    }
}