print("Katipo Host ", katipo.version)

### set defaults
katipo.trackerIP = "127.0.0.1"
katipo.trackerPort = "3470"
katipo.retry = true

printUsage = function()
{
    print("")
    print("Katipo Host version:", katipo.version)
    print("https://github.com/mjdave/katipo")
    print("")
    print("Usage: ./katipoHost --site exampleSites/basicSite")
    print("       ./katipoHost --help")
    print("       ./katipoHost --site exampleSites/basicSite --basePath . --trackerIP " + katipo.trackerIP + " --trackerPort " + katipo.trackerPort)
    print("")
    print("--site PATH")
    print("  A path to the directory containing the site to host. This directory should contain a site.tui file")
    print("  required")
    print("")
    print("--basePath PATH") #handled in Controller.cpp, as this is the location to find this very file
    print("  Were to find the host app resources eg this file, scripts/code.tui")
    print("  optional, default: the same directory as the katipoHost binary")
    print("")
    print("--privateSavePath SAVE_PATH") #handled in Controller.cpp
    print("  A private location to save site config files and private keys.")
    print("  optional, default: the same directory as the katipoHost binary")
    print("")
    print("--trackerIP example.com")
    print("  The IP for the tracker that you wish the host to share its content through. In the future you will be able to supply multiple tracker IPs.")
    print("  optional, default: 127.0.0.1, which assumes you are running a tracker on your local machine")
    print("")
    print("--trackerPort PORT")
    print("  The port for the tracker.")
    print("  optional, default: " + katipo.trackerPort)
    print("")
}


### loop over the launch arguments
argCount = table.count(launchArgs)
for(i = 0, i < argCount, i++)
{
    arg = launchArgs[i]
    if(arg == "--trackerIP")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoHost --trackerIP 127.0.0.1")
            return
        }
        i++
        katipo.trackerIP = launchArgs[i]
    }
    else if(arg == "--trackerPort")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoHost --trackerPort " + katipo.trackerPort)
            return
        }
        i++
        katipo.trackerPort = launchArgs[i]
    }
    else if(arg == "--site")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoHost --site exampleSites/basicSite")
            return
        }
        i++
        katipo.sitePath = launchArgs[i]
    }
    else if(arg == "--help")
    {
        printUsage()
        return
    }
}

katipo.host.start(true)