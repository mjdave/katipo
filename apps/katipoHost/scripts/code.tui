KATIPO_VERSION = "0.1" #todo

### set defaults
katipo.trackerIP = "127.0.0.1"
katipo.trackerPort = "3470"

printUsage = function()
{
    print("")
    print("Katipo Host version:", KATIPO_VERSION)
    print("https://github.com/mjdave/katipo")
    print("")
    print("Usage: ./katipoHost --site exampleSites/basicSite")
    print("       ./katipoHost --help")
    print("       ./katipoHost --site exampleSites/basicSite --basePath . --trackerIP " + katipo.trackerIP + " --trackerPort " + katipo.trackerPort)
    print("")
    print("--site SITE")
    print("  A path to the directory containing the site to host. This directory should contain a site.tui file")
    print("  required")
    print("")
    print("--basePath PATH") #handled in Controller.cpp, as this is the location to find this very file
    print("  Were to find scripts/code.tui")
    print("  optional, default: the same directory as the katipoHost binary")
    print("")
    print("--trackerIP example.com")
    print("  The IP for the tracker that you wish the host to share its content through. In the future you will be able to supply multiple tracker IPs.")
    print("  optional, default: 127.0.0.1, which assumes you are running a tracker on your local machine")
    print("")
    print("--trackerPort PORT")
    print("  The port for the tracker.")
    print("  optional, default: 3471")
    print("")
}


### loop over the launch arguments
argCount = table.count(launchArgs)
for(i = 0, i < argCount, i++)
{
    arg = launchArgs[i]
    if(arg == "--trackerIP")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoHost --trackerIP 127.0.0.1")
            return
        }
        i++
        katipo.trackerIP = launchArgs[i]
    }
    else if(arg == "--trackerPort")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoHost --trackerPort 3470")
            return
        }
        i++
        katipo.trackerPort = launchArgs[i]
    }
    else if(arg == "--site")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoHost --site exampleSites/basicSite")
            return
        }
        i++
        katipo.sitePath = launchArgs[i]
    }
    else if(arg == "--help")
    {
        printUsage()
        return
    }
}

if(!katipo.sitePath)
{
    print("\nError: katipoHost requires a site directory path to be passed with --site. run './katipoHost --help' for more information")
    return
}

siteInfoPath = katipo.sitePath + "/site.tui"
siteCodePath = katipo.sitePath + "/code.tui"

if(!file.fileExists(siteInfoPath))
{
    print("\nError: Unable to find site.tui file at:", file.getAbsolutePath(siteInfoPath))
    return
}

if(!file.fileExists(siteCodePath))
{
    print("\nError: Unable to find code.tui file at:", file.getAbsolutePath(siteCodePath))
    return
}

siteInfo = require(siteInfoPath)
siteCode = require(siteCodePath)
print("siteInfo:", siteInfo)
print("siteCode:", siteCode)

credentials = {
    publicKey = "1234567812345678" #todo
}

katipo.clientInfo = {
    siteInfo = siteInfo
    credentials = credentials
}

### initialize katipo now that we have loaded the launch args
success = katipo.init()
if(!success)
{
    print("Failed to initialize katipo.")
    return
}

print("Katipo initialized successfully.")

tracker = katipo.tracker

/*clientConnected = function(clientInfo) #todo maybe need this?
{
    print("in tui clientConnected. clientInfo:", clientInfo)
}*/

