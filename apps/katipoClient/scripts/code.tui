print("Katipo Client ", katipo.version)

printUsage = function()
{
    print("")
    print("Katipo Client version:", katipo.version)
    print("https://github.com/mjdave/katipo")
    print("")
    print("Usage: ./katipoClient --get SITE_URL")
    print("       ./katipoClient --help")
    print("       ./katipoClient --get exampleSite/exampleFile.txt --basePath .")
    print("")
    print("--get SITE_URL")
    print("  Fetches data from the remote site. SITE_URL is a basic url in the format TRACKER_IP/SITE_KEY/SUB_DATA")
    print("")
    print("     TRACKER_IP")
    print("     - Identifies a remote tracker to connect to. could be example.com or 127.0.0.1")
    print("     - Supports custom ports with the ':' syntax, eg.  example.com:1234")
    print("     - Can be skipped, the default is 127.0.0.1:3471")
    print("")
    print("     SITE_KEY")
    print("     - The site's main keyword, the 'key' specified in the host's site.tui file to identify the site")
    print("     - You could also pass multiple TRACKER_KEYs kere first, to chain together trackers, but this is not yet supported")
    print("")
    print("     SUB_DATA")
    print("     - optional additional data, can be used to provide a sub-path for the host")
    print("")
    print("--basePath PATH") #handled in Controller.cpp, as this is the location to find this very file
    print("  Were to find scripts/code.tui")
    print("  optional, default: the same directory as the katipoClient binary")
    print("")
}

### loop over the launch arguments

argCount = table.count(launchArgs)
for(i = 0, i < argCount, i++)
{
    arg = launchArgs[i]
    if(arg == "--help")
    {
        printUsage()
        return
    }
    else if(arg == "--get")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoHost --site exampleSites/basicSite")
            return
        }
        i++
        .siteURL = launchArgs[i]
    }
}

if(!siteURL)
{
    printUsage()
    return
}

waitingCount = 0 

loadCallback = function(result){
    
    if(result and result.fileData)
    {
        print("got file data result with status:", result.status, " fileName:", result.fileName)
        if(result.fileName)
        {
            localFileName = result.fileName #todo need to check this is within the sandbox
            if(file.fileExists(localFileName))
            {
                print("error: File exists:", localFileName)
                print("todo: could ask here for overwrite confirmation and/or have an option passed in somehow")
                exit(0)
            }

            print("writing file...")
            file.saveData(localFileName, result.fileData)
            print("saved file:", localFileName)
        }
        else
        {
            print("todo: unhandled fileData without fileName")
        }
    }
    else
    {
        print("got result:", result)
    }

    .waitingCount = waitingCount - 1

    if(waitingCount <= 0)
    {
        print("\nAll requests have finished, exiting.")
        exit(0)
    }
}

print("fetching:", siteURL)
waitingCount = waitingCount + 1
katipo.get(siteURL, loadCallback)

while(waitingCount > 0)
{
    value = readValue()

    if(value == "help")
    {
        print("commands:
\tquit|exit exits")
    }
    else if(value == "quit" or value == "exit")
    {
        break
    }
}

print("exiting")
