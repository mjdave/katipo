
siteInfosBySiteKeys = {}
siteInfosByHostIDs = {}

init = function()
{
    hostServer = katipo.hostServer
    clientServer = katipo.clientServer

    ### hosts

    hostServer.clientConnected = function(hostID, siteInfo)
    {
        print("host connected:", hostID)
        print("key:", siteInfo.nameKey)
        print("title:", siteInfo.title)

        siteNameKey = siteInfo.nameKey
        if(!siteNameKey)
        {
            message = "missing host nameKey"
            print("Error:", message)
            return {
                status = "error"
                message = message
            }
        }

        existingSiteInfo = siteInfosBySiteKeys[siteNameKey]

        if(existingSiteInfo)
        {
            if(hostID != existingSiteInfo.hostID) #todo this also needs security between sessions
            {
                message = "nameKey already in use by another host"
                print("Error:", message)
                return {
                    status = "error"
                    message = message
                }
            }
        }
        else
        {
            siteInfo.hostID = hostID
            siteInfosBySiteKeys[siteNameKey] = siteInfo
            siteInfosByHostIDs[hostID] = siteInfo
        }
        
        return {
            status = "ok"
        }
    }

    hostServer.clientDisconnected = function(hostID)
    {
        print("host disconnected:", hostID)
        if(siteInfosByHostIDs[hostID])
        {
            siteInfo = siteInfosByHostIDs[hostID]
            
            siteInfosBySiteKeys[siteInfo.nameKey] = nil
            siteInfosByHostIDs[hostID] = nil
        }
    }

    ### clients

    clientServer.clientConnected = function(clientID) #todo we probably want a keepalive interval, keep track of clients, kick them off if idle too long
    {
        print("client connected:", clientID)
    }

    clientServer.clientDisconnected = function(clientID)
    {
        print("client disconnected:", clientID)
    }

    getSiteKey = function(clientID, siteNameKey, callbackFunc)
    {
        siteNameKeyToUse = siteNameKey
        if(katipo.defaultHost and (!siteNameKeyToUse or siteNameKeyToUse == ""))
        {
            siteNameKeyToUse = katipo.defaultHost
        }

        if(siteNameKeyToUse and siteNameKeyToUse != "")
        {
            siteInfo = siteInfosBySiteKeys[siteNameKeyToUse]
            if(siteInfo)
            {
                result = {
                    status = "ok"
                    publicKey = siteInfo.publicKey
                }
                callbackFunc(result)
                return
            }
        }

        result = {
            status = "error"
            message = "no host found:" + siteNameKeyToUse
        }

        callbackFunc(result)
    }

    getSitesForBroadcastKey = function(clientID, broadcastKey, callbackFunc)
    {
        if(broadcastKey)
        {
            siteResults = {}
            for(siteID,siteInfo in siteInfosByHostIDs)
            {
                if(siteInfo.broadcastKey == broadcastKey)
                {
                    table.insert(siteResults, siteInfo)
                }
            }
            
            result = {
                status = "ok"
                sites = siteResults
            }
            callbackFunc(result)
        }

        result = {
            status = "error"
            message = "getSitesForBroadcastKey got nil broadcastKey"
        }

        callbackFunc(result)
    }

    #called by client
    clientServer.register("getSiteKey", getSiteKey)
    clientServer.register("getSitesForBroadcastKey", getSitesForBroadcastKey)
}
