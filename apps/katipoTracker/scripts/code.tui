

siteInfosBySiteKeys = {}

KATIPO_VERSION = "0.1" #todo

### loop over the launch arguments

argCount = table.count(launchArgs)
for(i = 0, i < argCount, i++)
{
    arg = launchArgs[i]

    if(arg == "--hostPort")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoTracker --hostPort 3470")
            return
        }
        i++
        katipo.hostPort = launchArgs[i]
    }
    else if(arg == "--clientPort")
    {
        if(i+1 >= argCount)
        {
            print("missing argument. usage example: ./katipoTracker --clientPort 3471")
            return
        }
        i++
        katipo.clientPort = launchArgs[i]
    }
    else if(arg == "--help")
    {
        print("")
        print("Katipo Tracker version:", KATIPO_VERSION)
        print("Example usage: ./katipoTracker --hostPort 3470 --clientPort 3471")
        print("")
        print("--basePath PATH") #this is handled by Controller.cpp
        print("  Were to find scripts/code.tui")
        print("  optional, default: the same directory as the katipoTracker binary")
        print("")
        print("--hostPort PORT")
        print("  The port hosts will connect to.")
        print("  optional, default: 3470")
        print("")
        print("--clientPort PORT")
        print("  The port clients will connect to.")
        print("  optional, default: 3471")
        return
    }
}

### initialize katipo now that we have loaded the launch args
success = katipo.init()

if(!success)
{
    print("Failed to initialize katipo.")
    return
}

hostServer = katipo.hostServer
clientServer = katipo.clientServer

### hosts

hostServer.clientConnected = function(hostID, siteInfo)
{
    print("host connected:", hostID)
    print("key:", siteInfo.nameKey)
    print("title:", siteInfo.title)

    siteNameKey = siteInfo.nameKey
    if(!siteNameKey)
    {
        message = "missing host nameKey"
        print("Error:", message)
        return {
            status = "error"
            message = message
        }
    }

    existingSiteInfo = siteInfosBySiteKeys[siteNameKey]

    if(existingSiteInfo)
    {
        if(hostID != existingSiteInfo.hostID)
        {
            message = "host nameKey already in use by another host"
            print("Error:", message)
            return {
                status = "error"
                message = message
            }
        }
    }
    else
    {
        siteInfo.hostID = hostID
        siteInfosBySiteKeys[siteNameKey] = siteInfo
    }
    
    return {
        status = "ok"
    }
}

hostServer.clientDisconnected = function(hostID) #todo
{
    print("host disconnected:", hostID)
}

### clients

clientServer.clientConnected = function(clientID)
{
    print("client connected:", clientID)
}

getSiteKey = function(clientID, siteNameKey, callbackFunc)
{
    if(siteNameKey)
    {
        siteInfo = siteInfosBySiteKeys[siteNameKey]
        if(siteInfo)
        {
            result = {
                status = "ok"
                publicKey = siteInfo.publicKey
            }
            callbackFunc(result)
            return
        }
    }

    result = {
        status = "error"
        message = "no host found:" + siteNameKey
    }

    callbackFunc(result)
}

#called by client
clientServer.register("getSiteKey", getSiteKey)

### start the servers
success = katipo.start()

if(!success)
{
    print("Failed to start katipo servers.")
    return
}

print("katipoTracker is running with host port ", katipo.hostPort, " and client port ", katipo.clientPort, " and is ready for connections.
Type 'help' for commands."
)

while(true)
{
    value = readValue()

    if(value == "help")
    {
        print("commands:
\tquit|exit|q exits")
    }
    else if(value == "list")
    {
        //printConnectedLists()
    }
    else if(value == "quit" or value == "exit" or value == "q")
    {
        break
    }
}